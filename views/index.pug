            <div class="card-box">
                <div class="card-img">
                    <img src="/static/img/pos2.jpg" alt="Dance Image 2">
                </div>
                <div class="card-content">
                    <p>This is the best dance academy of the universe</p>
                </div>
            </div>
        </div>

        <div class="card">
            <h3>Expert Teaching</h3>
            <div class="card-box">
                <div class="card-img">
                    <img src="/static/img/pos1.jpg" alt="Dance Image 3">
                </div>
                <div class="card-content">
                    <p>This is the best dance academy of the universe</p>
                </div>
            </div>
        </div>
