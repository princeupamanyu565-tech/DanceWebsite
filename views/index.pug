<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ishika Dance Academy</title>
    <link rel="stylesheet" href="../static/style.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav id="navbar">
        <ul>
            <div id="logo">
                <img src="/static/img/logo.png" alt="Dance Academy Logo">
